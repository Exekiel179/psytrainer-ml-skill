# Paths may be absolute or relative to this file.

[PsyTrainer]
# Smoke-check against bundled fixtures (dry-run only unless PsyTrainer is installed):
# feature_file = ../fixtures/features.csv
# label_file = ../fixtures/labels.csv
feature_file = ../data/features.csv
label_file = ../data/labels.csv
output_dir = ../outputs/training
train_type = general
cv_times = 5
pca_num = 0
is_need_clean = true
is_use_model_params = false
scoring =
ff_tags = all_ff
model_tags = classification
resample_tags = all_resample

[batch_predict]
feature_file = ../data/features_to_predict.csv
# Only use a model_root produced by a trusted local training run.
model_root = ../outputs/training/example_target
output_dir = ../outputs/predictions
